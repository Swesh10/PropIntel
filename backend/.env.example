# Percent-encode username and password separately if they contain special characters.
# Use urllib.parse.quote_plus on each raw credential; do not encode the full URI.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=PropIntel
MONGODB_DB_NAME=propintel
PROPINTEL_ENV=development
PROPINTEL_AUTH_SECRET=
# In production, set both admin values to enable the optional administrator login.
PROPINTEL_ADMIN_EMAIL=
PROPINTEL_ADMIN_PASSWORD=
# Set the deployed frontend origin(s) when the frontend and API use different origins.
PROPINTEL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
FRONTEND_BASE_URL=http://localhost:5173
